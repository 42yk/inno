      {
        "parameters": {
          "jsCode": "return items.map((item) => {\n  const source = item.json;\n  const originalUrl = source.link || source.guid || '';\n  const guid = source.guid || source.id || '';\n  return {\n    json: {\n      title: source.title || '',\n      originalUrl,\n      guid,\n      dedupeKey: guid || originalUrl,\n      publishedAt: source.isoDate || source.pubDate || new Date().toISOString(),\n      content: source.content || source.contentSnippet || source.description || '',\n      source: $json.sourceName || 'RSS Source'\n    }\n  };\n});"
        },
        "id": "normalize-rss-items",
        "name": "Normalize RSS Items",
        "type": "n8n-nodes-base.code",
        "typeVersion": 1,
        "position": [
          1648,
          64
        ]
      },
      {
        "parameters": {
          "method": "GET",
          "url": "={{ $json.originalUrl }}",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "User-Agent",
                "value": "Mozilla/5.0 (compatible; B2-2 RSS AI News Summary/1.0)"
              },
              {
                "name": "Accept",
                "value": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
              }
            ]
          },
          "options": {
